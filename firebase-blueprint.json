{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "stock", "userId"]
    },
    "Order": {
      "title": "Order",
      "description": "Store customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerEmail": { "type": "string", "maxLength": 100 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "completed", "cancelled"] },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "refunded"] },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "totalAmount", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "userId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact & spend record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "totalOrders": { "type": "number" },
        "totalSpend": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "userId"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and profile",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "currency": { "type": "string", "maxLength": 10 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeName", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Per-user product catalog"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Per-user customer orders"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Per-user product categories"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Per-user customer list"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Per-user store settings"
    }
  }
}
