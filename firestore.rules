rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All (Anti-Leak Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing endpoint for app boot health checks
    match /test/connection {
      allow read: if true;
    }

    // ==========================================
    // PER-USER NAMESPACED DATA ISOLATION
    // Path: /users/{userId}/**
    // Ensures every user can ONLY read and write their own data.
    // ==========================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Specific subcollections for Toko Online
      match /products/{productId} {
        allow read, write: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /customers/{customerId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any other nested subcollections under user's space
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==========================================
    // ROOT-LEVEL COLLECTIONS (Field-based Guard)
    // If documents are written at root with userId field
    // ==========================================
    match /products/{productId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
  }
}
